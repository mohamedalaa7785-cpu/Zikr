{
  "name": "zikr",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "db:migrate:supabase": "pnpm dlx supabase db push",
    "lint": "eslint .",
    "deploy:check": "node scripts/validate-deployment-env.mjs",
    "typecheck": "tsc --noEmit",
    "cap": "pnpm dlx @capacitor/cli",
    "cap:sync": "pnpm dlx @capacitor/cli sync",
    "cap:android": "pnpm dlx @capacitor/cli open android",
    "cap:ios": "pnpm dlx @capacitor/cli open ios",
    "mobile:build": "pnpm build && pnpm cap:sync",
    "mobile:check": "node scripts/verify-mobile-readiness.mjs",
    "routes:check": "node scripts/verify-platform-routes.mjs",
    "verify": "pnpm routes:check && pnpm imports:check && pnpm mobile:check && pnpm lint && pnpm check && pnpm build",
    "imports:check": "node scripts/verify-local-imports.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.15",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.453.0",
    "next": "^16.2.7",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.4.47",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
