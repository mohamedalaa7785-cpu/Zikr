{
  "name": "zikr",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "tsx --test __tests__/unit/*.test.ts __tests__/integration/*.test.ts",
    "format": "prettier --write .",
    "db:migrate:supabase": "pnpm dlx supabase db push",
    "lint": "eslint .",
    "deploy:check": "node scripts/validate-deployment-env.mjs",
    "typecheck": "tsc --noEmit",
    "cap": "pnpm dlx @capacitor/cli",
    "cap:sync": "pnpm dlx @capacitor/cli sync",
    "cap:android": "pnpm dlx @capacitor/cli open android",
    "cap:ios": "pnpm dlx @capacitor/cli open ios",
    "mobile:build": "pnpm build && pnpm cap:sync",
    "mobile:check": "node scripts/verify-mobile-readiness.mjs",
    "supabase:migrations:check": "node scripts/check-supabase-migrations.mjs",
    "supabase:migrations:replay": "node scripts/validate-migrations.mjs",
    "routes:check": "node scripts/verify-platform-routes.mjs",
    "verify": "pnpm supabase:migrations:check && pnpm supabase:migrations:replay && pnpm routes:check && pnpm imports:check && pnpm mobile:check && pnpm lint && pnpm check && pnpm test && pnpm build",
    "imports:check": "node scripts/verify-local-imports.mjs",
    "background:jobs": "tsx scripts/run-background-jobs.ts",
    "automation:run": "tsx scripts/run-background-jobs.ts",
    "launch:smoke": "node scripts/production-smoke-test.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.66",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.2",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0"
}
