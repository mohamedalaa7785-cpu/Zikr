# ──────────────────────────────────────────────
# ZIKR – Environment Variables Reference
# Copy this file to .env.local and fill in values.
# NEXT_PUBLIC_ prefixes are safe to expose to the browser.
# All other variables are server-only – never commit real values.
#
# Note: lib/env.ts also resolves Vercel-integration suffixed names
# (e.g. SUPABASE_URL_19) automatically; prefer the bare names below.
# ──────────────────────────────────────────────

# ── Site ───────────────────────────────────────
# Canonical origin of the deployment. Falls back to the production URL
# defined in lib/site.ts (PRODUCTION_URL) when unset.
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app

# ── Supabase (required) ─────────────────────────
# Browser client uses the public keys only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/admin-only – never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Postgres, used by Drizzle + scripts) ──
# Any one of these is enough; DATABASE_URL is preferred.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ── Auth ───────────────────────────────────────
# Must point to this app's /auth/callback (NOT the Supabase /auth/v1/callback).
# Defaults to ${NEXT_PUBLIC_SITE_URL}/auth/callback when unset.
AUTH_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Cron (required in production) ────────────────
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── YouTube Integration (optional) ───────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_REFRESH_TOKEN=

# ── Gemini AI (optional) ─────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Islamic content APIs (optional, sane defaults exist) ──
QURAN_API_BASE_URL=
QURAN_AUDIO_CDN_URL=
HADITH_API_BASE_URL=
NEXT_PUBLIC_QURAN_API=
NEXT_PUBLIC_HADITH_API=

# ── AWS S3 (optional, media storage) ─────────────
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
AWS_S3_PUBLIC_BASE_URL=

# ── HeyGen Video Generation (optional) ───────────
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ── Facebook Integration (optional) ──────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
