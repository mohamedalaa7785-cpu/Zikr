# ══════════════════════════════════════════════════════════════════════════════
# ZIKR MEDIA – Environment Variables Reference
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* prefixes are safe to expose to the browser.
# All other variables are server-only – NEVER commit real values.
#
# Generation Date: July 31, 2026
# Version: 1.0.0 Production Ready
# ══════════════════════════════════════════════════════════════════════════════

# ── CRITICAL: Site Configuration ───────────────────────────────────────────────
# Canonical origin of the deployment. Used for all URLs and redirects.
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app

# ── CRITICAL: Supabase Configuration ───────────────────────────────────────────
# Browser client uses the public keys only (safe to expose).
# Get from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://eydxvcamhjhajxjrsgym.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://eydxvcamhjhajxjrsgym.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-only – NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# ── CRITICAL: PostgreSQL Database ──────────────────────────────────────────────
# Used by Drizzle ORM and scripts. Supports both connection pooling and direct.
# Get from: Supabase Dashboard > Project Settings > Database
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgresql://postgres.xxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_USER=postgres.xxxxx
POSTGRES_PASSWORD=
POSTGRES_HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES_DATABASE=postgres

# ── CRITICAL: Authentication & OAuth ───────────────────────────────────────────
# OAuth callback URL registered with Google/Facebook
AUTH_CALLBACK_URL=https://eydxvcamhjhajxjrsgym.supabase.co/auth/v1/callback

# Google OAuth (Get from: Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook Integration (Optional – for social sharing)
FACEBOOK_APP_ID=1547748713614342
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=993431613855177

# ── YouTube Integration (Optional but recommended) ────────────────────────────
# Get from: Google Cloud Console > YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCIq_kU6XE1WuEmQXKaGF6ow
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
VIDEO_AUTO_PUBLISH=false
VIDEO_PUBLISH_SCHEDULE=

# ── Gemini AI Integration (Optional) ───────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Islamic Content APIs ───────────────────────────────────────────────────────
# Default APIs with fallbacks – no setup needed unless you want custom ones
QURAN_API_BASE_URL=https://api.alquran.cloud/v1
QURAN_AUDIO_CDN_URL=https://cdn.islamic.network/quran/audio
HADITH_API_BASE_URL=https://hadithapi.com/api
NEXT_PUBLIC_QURAN_API=https://api.alquran.cloud/v1
NEXT_PUBLIC_HADITH_API=https://hadithapi.com/api

# ── Google Ads & Analytics ────────────────────────────────────────────────────
# AdSense (Optional – for monetization)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Google Analytics 4 (Set directly in Google Analytics dashboard)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── AI Gateway (Vercel) ─────────────────────────────────────────────────────────
# Optional: For advanced AI features through Vercel AI Gateway
AI_GATEWAY_API_KEY=

# ── Media Storage: AWS S3 (Optional) ───────────────────────────────────────────
# Get from: AWS IAM Console
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1
AWS_S3_PUBLIC_BASE_URL=https://s3.amazonaws.com/your-bucket

# ── Video Generation: HeyGen (Optional) ────────────────────────────────────────
# Get from: HeyGen Dashboard
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ── GitHub Integration (For automated workflows) ─────────────────────────────────
# Get from: GitHub Settings > Developer settings > Personal access tokens
GITHUB_PAT=
GITHUB_FINE_GRAINED_PAT=

# ── Vercel KV (Optional – for caching/sessions) ────────────────────────────────
# Get from: Vercel Dashboard > Storage > KV
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Webhook Signing (Internal) ────────────────────────────────────────────────
# Auto-generated – never change
WEBHOOK_SECRET=your-webhook-secret-here
