# ──────────────────────────────────────────────
# ZIKR – Environment Variables Reference
# Copy this file to .env.local and fill in values.
# NEXT_PUBLIC_ prefixes are safe to expose to the browser.
# All other variables are server-only – never commit real values.
# ──────────────────────────────────────────────

# ── Site ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zikr.app

# ── Supabase (required) ─────────────────────────
# Browser client uses the public keys only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/admin-only – never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Alternate Supabase variable names used by some Supabase CLI versions.
# Keep in sync with the values above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ── Database (Neon / Postgres, if used alongside Supabase) ──
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# ── Auth ───────────────────────────────────────
AUTH_CALLBACK_URL=https://zikr.app/auth/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── YouTube Integration ─────────────────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Auto-publish scheduled videos (true/false)
VIDEO_AUTO_PUBLISH=false
VIDEO_PUBLISH_SCHEDULE=0 9 * * *

# ── Facebook Integration ────────────────────────
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# ── AI (Gemini / Vercel AI Gateway) ─────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Required only when using non-default AI Gateway providers (e.g. xAI).
AI_GATEWAY_API_KEY=

# ── HeyGen Video Generation (optional) ──────────
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
