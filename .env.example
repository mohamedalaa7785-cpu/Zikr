# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Optional Vercel/Supabase alias; app normalizes this to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the Supabase anon JWT/public API key for browser + REST requests. Do not commit real keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional aliases accepted by validation/runtime normalization.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Database
DATABASE_URL=
# Vercel Supabase integration fallbacks accepted by Drizzle/runtime validation.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Must be the app route below, not /api/auth/callback.
AUTH_CALLBACK_URL=https://your-domain.example/auth/callback

