# ──────────────────────────────────────────────
# ZIKR – Environment Variables Reference
# Copy this file to .env.local and fill in values.
# NEXT_PUBLIC_ prefixes are safe to expose to the browser.
# All other variables are server-only – never commit real values.
#
# ──────────────────────────────────────────────

# ── Site ───────────────────────────────────────
# Canonical origin of the deployment. Falls back to the production URL
# defined in lib/site.ts (PRODUCTION_URL) when unset.
NEXT_PUBLIC_SITE_URL=https://zikrmediaofficial.vercel.app

# ── Supabase (required) ─────────────────────────
# Browser client uses the public keys only. SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_PUBLISHABLE_KEY are accepted aliases for deployment providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server/admin-only – never expose to the browser. SUPABASE_SECRET_KEY is
# accepted as a server-only alias when using Supabase platform secret keys.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# ── Database (Postgres, used by Drizzle + scripts) ──
# Any one of these is enough; DATABASE_URL is preferred.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=

# ── Auth ───────────────────────────────────────
# OAuth provider callback registered with Google/Facebook. Supabase-hosted
# OAuth providers should use the Supabase /auth/v1/callback endpoint.
AUTH_CALLBACK_URL=https://eydxvcamhjhajxjrsgym.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Cron (required in production) ────────────────
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── YouTube Integration (optional) ───────────────
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
VIDEO_AUTO_PUBLISH=false
VIDEO_PUBLISH_SCHEDULE=

# ── Gemini AI (optional) ─────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Islamic content APIs (optional, sane defaults exist) ──
QURAN_API_BASE_URL=
QURAN_AUDIO_CDN_URL=
HADITH_API_BASE_URL=
NEXT_PUBLIC_QURAN_API=
NEXT_PUBLIC_HADITH_API=
NEXT_PUBLIC_ADSENSE_CLIENT=
AI_GATEWAY_API_KEY=

# ── AWS S3 (optional, media storage) ─────────────
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
AWS_S3_PUBLIC_BASE_URL=

# ── HeyGen Video Generation (optional) ───────────
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ── Facebook Integration (optional) ──────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
